<odoo>
    <record id="paperformat_delivery_landscape" model="report.paperformat">
        <field name="name">RO Delivery / Reception A4 Landscape</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <!-- The delivery slip / reception note has many RO columns (valued and
         retail), so it is printed on A4 landscape to keep them readable. -->
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field
            name="paperformat_id"
            ref="l10n_ro_stock_picking_valued_report.paperformat_delivery_landscape"
        />
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_retail_report_list" model="ir.ui.view">
        <field name="name">l10n.ro.stock.retail.report.list</field>
        <field name="model">l10n.ro.stock.retail.report</field>
        <field name="arch" type="xml">
            <list
                string="Retail Stock (Marfa in Magazin)"
                create="false"
                edit="false"
                decoration-warning="price_gap_total != 0"
            >
                <field name="warehouse_id" />
                <field name="product_id" />
                <field name="categ_id" optional="hide" />
                <field name="quantity" />
                <field name="cost_unit" optional="hide" />
                <field name="cost_total" sum="Stock Value (cost)" />
                <field name="markup_total" sum="Markup Carried (378)" />
                <field name="vat_total" sum="Deferred VAT Carried (4428)" />
                <field name="retail_value" sum="Retail Value (371)" />
                <field name="retail_price_unit" />
                <field name="current_price_unit" />
                <field name="price_gap_total" sum="To Revalue" />
                <field name="currency_id" column_invisible="1" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_stock_retail_report_search" model="ir.ui.view">
        <field name="name">l10n.ro.stock.retail.report.search</field>
        <field name="model">l10n.ro.stock.retail.report</field>
        <field name="arch" type="xml">
            <search string="Retail Stock">
                <field name="warehouse_id" />
                <field name="product_id" />
                <field name="categ_id" />
                <group>
                    <filter
                        name="group_warehouse"
                        string="Warehouse"
                        domain="[]"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        name="group_category"
                        string="Category"
                        domain="[]"
                        context="{'group_by': 'categ_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_retail_report" model="ir.actions.act_window">
        <field name="name">Retail Stock (Marfa in Magazin)</field>
        <field name="res_model">l10n.ro.stock.retail.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_stock_retail_report_search" />
    </record>

    <menuitem
        id="menu_stock_retail_report"
        name="Retail Stock (Marfa in Magazin)"
        parent="stock.menu_warehouse_report"
        action="action_stock_retail_report"
        sequence="100"
    />
</odoo>
